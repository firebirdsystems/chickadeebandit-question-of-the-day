{
  "id": "question-of-the-day",
  "contexts": ["household", "shared_space"],
  "name": "Question of the Day",
  "version": "1.0.0",
  "description": "One conversation-starter a day. Everyone answers in secret; the answers unlock when the whole household has weighed in — or automatically at the end of the day.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "games",
  "tags": ["family", "questions", "conversation", "daily", "game"],
  "icon": "💬",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": ["question_date"],
  "row_policies": {
    "rounds": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_visibility_scoped": true,
      "retain_days": {
        "default": 365,
        "timestamp_column": "question_date",
        "override_key": "question_history",
        "dependent_tables": [
          { "table": "answers", "foreign_key": "round_id" },
          { "table": "marks", "foreign_key": "round_id" }
        ]
      }
    },
    "answers": {
      "kind": "sealed_until",
      "fk_column": "round_id",
      "parent_table": "rounds",
      "writer_column": "member_id",
      "parent_status_column": "status",
      "visible_parent_status_values": ["closed"],
      "visible_after_parent_column": "reveal_at",
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["round_id"],
        "limit": 1
      },
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed"]
      }
    },
    "marks": {
      "kind": "inherit_visibility",
      "fk_column": "round_id",
      "parent_table": "rounds",
      "writer_column": "member_id",
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["round_id"],
        "limit": 1
      }
    }
  },
  "member_references": {
    "rounds": { "column": "created_by", "on_removed": "keep" },
    "answers": { "column": "member_id", "on_removed": "delete" },
    "marks": { "column": "member_id", "on_removed": "delete" }
  },
  "nav": { "label": "Question" },
  "agenda": {
    "kind": "routine",
    "label": "Question",
    "source": {
      "kind": "sql",
      "query": "SELECT r.id AS id, r.question AS title, r.question_date AS when_at, CASE WHEN m.id IS NULL THEN 0 ELSE 1 END AS done FROM app_question_of_the_day__rounds r LEFT JOIN app_question_of_the_day__marks m ON m.round_id = r.id AND m.member_id = :me WHERE r.question_date = :today AND r.status = 'open' LIMIT 5"
    }
  },
  "publishes": ["qotd.question_posted", "qotd.answers_revealed"],
  "publish_acls": {
    "qotd.question_posted": { "require_role": "member" },
    "qotd.answers_revealed": { "require_role": "member" }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT question AS title FROM app_question_of_the_day__rounds WHERE question_date = :today AND status = 'open' ORDER BY created_at DESC LIMIT 1"
    },
    "display": { "template": "list", "title": "title" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  }
}
